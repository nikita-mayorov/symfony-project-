{% extends "base.html.twig" %}

{% block title %}{{ task.title }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ task.title }}</h1>
    <div>
        <a href="{{ path('app_task_edit', {id: task.id}) }}" class="btn btn-outline-primary">Edit</a>
        <form method="post" action="{{ path('app_task_delete', {id: task.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this task?')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-task-' ~ task.id) }}">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Status</div>
            <div class="col-md-9">
                <span class="badge bg-{{ task.status.value == 'done' ? 'success' : task.status.value == 'in_progress' ? 'warning' : 'secondary' }}">
                    {{ task.status.value|replace({'_': ' '})|title }}
                </span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Priority</div>
            <div class="col-md-9">
                <span class="badge bg-{{ task.priority.value == 'high' ? 'danger' : task.priority.value == 'medium' ? 'warning text-dark' : 'secondary' }}">
                    {{ task.priority.value|title }}
                </span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Due Date</div>
            <div class="col-md-9">{{ task.dueDate ? task.dueDate|date('M d, Y') : 'Not set' }}</div>
        </div>
        <div class="row mb-3">
            <div class="col-md-3 fw-bold">Created</div>
            <div class="col-md-9">{{ task.createdAt|date('M d, Y H:i') }}</div>
        </div>
        {% if task.description %}
        <hr>
        <h5>Description</h5>
        <p class="mb-0">{{ task.description|nl2br }}</p>
        {% endif %}
    </div>
</div>

<div class="mt-3">
    <a href="{{ path('app_task_index') }}" class="btn btn-outline-secondary">Back to Tasks</a>
</div>
{% endblock %}
