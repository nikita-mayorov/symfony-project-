{% if pages > 1 %}
<nav aria-label="Task pagination">
    <ul class="pagination justify-content-center">
        {% if page > 1 %}
        <li class="page-item">
            <a class="page-link" href="{{ path('app_task_index', app.request.query.all|merge({page: page - 1})) }}">Previous</a>
        </li>
        {% else %}
        <li class="page-item disabled">
            <span class="page-link">Previous</span>
        </li>
        {% endif %}

        {% for i in 1..pages %}
        <li class="page-item{{ i == page ? ' active' : '' }}">
            <a class="page-link" href="{{ path('app_task_index', app.request.query.all|merge({page: i})) }}">{{ i }}</a>
        </li>
        {% endfor %}

        {% if page < pages %}
        <li class="page-item">
            <a class="page-link" href="{{ path('app_task_index', app.request.query.all|merge({page: page + 1})) }}">Next</a>
        </li>
        {% else %}
        <li class="page-item disabled">
            <span class="page-link">Next</span>
        </li>
        {% endif %}
    </ul>
</nav>
{% endif %}
