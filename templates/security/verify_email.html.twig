{% extends "base.html.twig" %}

{% block title %}Verify Email{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="mb-4">Verify Your Email</h1>

        {% if email %}
            <div class="alert alert-info">
                A verification code has been sent to <strong>{{ email }}</strong>.
                Please check your email and enter the code below.
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_verify_email_submit') }}">
            <div class="mb-3">
                <label for="code" class="form-label">Verification Code</label>
                <input type="text" id="code" name="code" class="form-control" maxlength="6" placeholder="000000" required autofocus>
            </div>
            <input type="hidden" name="email" value="{{ email }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('verify_email') }}">
            <button type="submit" class="btn btn-primary w-100">Verify</button>
        </form>

        {% if email %}
        <form method="post" action="{{ path('app_verify_resend') }}" class="mt-2">
            <input type="hidden" name="email" value="{{ email }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('verify_resend') }}">
            <button type="submit" class="btn btn-outline-secondary w-100">Resend Code</button>
        </form>
        {% endif %}

        <p class="mt-3 text-center">
            <a href="{{ path('app_login') }}">Back to Login</a>
        </p>
    </div>
</div>
{% endblock %}
