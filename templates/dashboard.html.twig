{% extends "base.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<h1 class="mb-4">Dashboard</h1>
<p>Welcome, <strong>{{ app.user.email }}</strong>!</p>

{% if stats.total > 0 %}
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-bg-primary">
            <div class="card-body text-center">
                <h5 class="card-title">Total</h5>
                <p class="display-6 mb-0">{{ stats.total }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-bg-secondary">
            <div class="card-body text-center">
                <h5 class="card-title">Todo</h5>
                <p class="display-6 mb-0">{{ stats.todo }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-bg-warning">
            <div class="card-body text-center">
                <h5 class="card-title">In Progress</h5>
                <p class="display-6 mb-0">{{ stats.in_progress }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-bg-success">
            <div class="card-body text-center">
                <h5 class="card-title">Done</h5>
                <p class="display-6 mb-0">{{ stats.done }}</p>
            </div>
        </div>
    </div>
</div>
<div class="text-center">
    <a href="{{ path('app_task_index') }}" class="btn btn-primary btn-lg">View Tasks</a>
</div>
{% else %}
<div class="text-center py-5">
    <p class="text-muted mb-3">You don't have any tasks yet.</p>
    <a href="{{ path('app_task_new') }}" class="btn btn-primary btn-lg">Create Your First Task</a>
</div>
{% endif %}
{% endblock %}
